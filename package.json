{
  "name": "pareesh-ecosystem-root",
  "private": true,
  "description": "Production-grade, scalable frontend utility and library package ecosystem under the @pareesh scope",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "turbo run build --concurrency=4",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck --concurrency=4",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"docs/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && rimraf node_modules",
    "dev:docs": "pnpm --filter @pareesh/docs dev",
    "build:docs": "pnpm --filter @pareesh/docs build",
    "preview:docs": "pnpm --filter @pareesh/docs preview"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^9.20.0",
    "happy-dom": "^17.1.6",
    "prettier": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.6",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
