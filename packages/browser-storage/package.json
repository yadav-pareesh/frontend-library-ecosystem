{
  "name": "@pareeshy/browser-storage",
  "version": "1.0.1",
  "description": "Unified browser storage abstraction for localStorage, sessionStorage, and IndexedDB with typed schemas, custom serialization, and clean async API.",
  "author": "Pareesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yadav-pareesh/frontend-library-ecosystem.git",
    "directory": "packages/browser-storage"
  },
  "keywords": [
    "storage",
    "indexeddb",
    "localstorage",
    "sessionstorage",
    "typed-storage",
    "browser"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pareeshy/internal-utils": "workspace:*"
  }
}