{
  "name": "@pareeshy/file-validator",
  "version": "1.0.0",
  "description": "Comprehensive client-side file validation library supporting MIME types, magic bytes detection, size limits, image dimensions, and detailed error reports.",
  "author": "Pareesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pareesh/frontend-library-ecosystem.git",
    "directory": "packages/file-validator"
  },
  "keywords": ["files", "validation", "file-upload", "mime-type", "file-size", "magic-bytes"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pareeshy/internal-utils": "workspace:*"
  }
}
