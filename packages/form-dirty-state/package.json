{
  "name": "@pareesh/form-dirty-state",
  "version": "1.0.0",
  "description": "High-performance dirty state detection hook for React forms with deep equality, reset control, and beforeunload prompt integration.",
  "author": "Pareesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pareesh/frontend-library-ecosystem.git",
    "directory": "packages/form-dirty-state"
  },
  "keywords": ["react", "hooks", "forms", "dirty-state", "unsaved-changes", "beforeunload"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@pareesh/internal-utils": "workspace:*"
  }
}
