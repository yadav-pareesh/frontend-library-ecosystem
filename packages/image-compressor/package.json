{
  "name": "@pareeshy/image-compressor",
  "version": "1.0.1",
  "description": "High-performance client-side image compression library supporting JPEG, PNG, and WebP with dimension resizing and Blob/File output.",
  "author": "Pareesh Yadav",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yadav-pareesh/frontend-library-ecosystem.git",
    "directory": "packages/image-compressor"
  },
  "keywords": [
    "image",
    "compress",
    "image-compression",
    "canvas",
    "webp",
    "jpeg",
    "resize"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pareeshy/internal-utils": "workspace:*"
  }
}