{
  "name": "@pareesh/react-error-boundary-lite",
  "version": "1.0.0",
  "description": "Ultra-lightweight, resilient React Error Boundary component with reset keys, retry handler, and render prop support.",
  "author": "Pareesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pareesh/frontend-library-ecosystem.git",
    "directory": "packages/react-error-boundary-lite"
  },
  "keywords": ["react", "error-boundary", "catch", "errors", "react-error-boundary", "resilience"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@pareesh/internal-utils": "workspace:*"
  }
