{
  "name": "@pareeshy/react-file-dropzone-lite",
  "version": "1.0.1",
  "description": "Lightweight, headless drag-and-drop file upload zone hook and component for React with full keyboard navigation and validation support.",
  "author": "Pareesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yadav-pareesh/frontend-library-ecosystem.git",
    "directory": "packages/react-file-dropzone-lite"
  },
  "keywords": [
    "react",
    "dropzone",
    "file-upload",
    "drag-and-drop",
    "dnd",
    "file-selector"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@pareeshy/internal-utils": "workspace:*"
  }
}