{
  "name": "@pareeshy/safe-json",
  "version": "1.0.0",
  "description": "Safe JSON serialization and parsing utilities with circular reference resolution, typed fallback results, and detailed syntax errors.",
  "author": "Pareesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pareesh/frontend-library-ecosystem.git",
    "directory": "packages/safe-json"
  },
  "keywords": ["json", "safe-parse", "safe-stringify", "circular-reference", "typesafe"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pareeshy/internal-utils": "workspace:*"
  }
}
