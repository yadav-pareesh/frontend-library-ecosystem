{
  "name": "@pareesh/url-state",
  "version": "1.0.0",
  "description": "Seamless bidirectional synchronization of React state with browser URL search parameters supporting numbers, booleans, arrays, push/replace modes, and SSR.",
  "author": "Pareesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pareesh/frontend-library-ecosystem.git",
    "directory": "packages/url-state"
  },
  "keywords": ["react", "hooks", "url-state", "query-params", "router", "history", "search-params"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@pareesh/internal-utils": "workspace:*"
  }
}
