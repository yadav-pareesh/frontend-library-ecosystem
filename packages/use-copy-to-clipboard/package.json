{
  "name": "@pareesh/use-copy-to-clipboard",
  "version": "1.0.0",
  "description": "Robust React hook for copying text to clipboard with modern Clipboard API, textarea fallback, copied state, and configurable timeout.",
  "author": "Pareesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pareesh/frontend-library-ecosystem.git",
    "directory": "packages/use-copy-to-clipboard"
  },
  "keywords": ["react", "hooks", "clipboard", "copy", "copy-to-clipboard"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@pareesh/internal-utils": "workspace:*"
  }
}
