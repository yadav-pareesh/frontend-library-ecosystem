{
  "name": "@pareeshy/use-local-storage-state",
  "version": "1.0.0",
  "description": "Reactive, type-safe localStorage state hook for React with cross-tab synchronization and SSR safety.",
  "author": "Pareesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pareesh/frontend-library-ecosystem.git",
    "directory": "packages/use-local-storage-state"
  },
  "keywords": ["react", "hooks", "localStorage", "state", "storage", "cross-tab", "ssr"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@pareeshy/internal-utils": "workspace:*"
  }
}
