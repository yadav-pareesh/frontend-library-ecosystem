{
  "name": "@pareeshy/use-media-query",
  "version": "1.0.0",
  "description": "SSR-safe reactive media query hook for React with matchMedia listener support and fallback values.",
  "author": "Pareesh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pareesh/frontend-library-ecosystem.git",
    "directory": "packages/use-media-query"
  },
  "keywords": ["react", "hooks", "media-query", "matchMedia", "responsive", "ssr"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@pareeshy/internal-utils": "workspace:*"
  }
}
